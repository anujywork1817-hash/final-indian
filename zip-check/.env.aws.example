# ============================================
# Elastic Beanstalk environment variables (production)
# ============================================
# Do NOT put real values in this file or commit it with secrets filled in.
# Set these via `eb setenv KEY=VALUE ...` or the EB console
# (Configuration → Software → Environment properties). See DEPLOY.md.

# RDS Postgres connection string. sslmode=require because RDS enforces TLS.
DATABASE_URL=postgresql://postgres:REPLACE_ME@your-db.xxxxxxxx.ap-south-1.rds.amazonaws.com:5432/kumbh_tent?sslmode=require

# Generate a fresh random secret for production — do not reuse the local dev value.
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_SECRET

# Live (or a dedicated prod test) Razorpay keys — do not reuse local dev test keys.
RAZORPAY_KEY_ID=REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME

# EB's default listener/health-check expects the app on port 80.
GATEWAY_PORT=80
