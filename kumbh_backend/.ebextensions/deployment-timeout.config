# 2026-09-02: a cold instance (no Docker layer cache) building 5 Go
# services from scratch — each pulling its full module graph (Firebase
# admin SDK, Google auth, Razorpay, Gin, pq, etc.) — has been observed
# to exceed 1800s even with only ONE instance building at a time under
# the Rolling policy. Raised to give a cold build real headroom instead
# of the deploy aborting mid-build.
option_settings:
  aws:elasticbeanstalk:command:
    Timeout: '3600'