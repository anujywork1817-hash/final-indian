# 2026-09-02 incident: an AllAtOnce deploy rebuilt 5 Docker images from
# scratch on all 4 instances simultaneously, exhausting memory and hanging
# every instance (SSM/EB health agents both went unresponsive for 30+ min,
# the deploy command itself timed out and aborted). Recovered by manually
# terminating the hung instances and letting the ASG relaunch them.
#
# Switching to a Rolling policy with a batch size of 1 so a deploy only
# ever rebuilds on one instance at a time, keeping the other instances
# serving traffic and avoiding this resource pile-up.
option_settings:
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Rolling
    BatchSizeType: Fixed
    BatchSize: '1'
