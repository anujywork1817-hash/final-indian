# ─────────────────────────────────────────────────────────────────────────────
# Per-instance connection-acceptance tuning. Pairs with 01-capacity.config.
#
# The dropped SYNs seen in load testing happen when the kernel accept queue
# (min of net.core.somaxconn and the listen() backlog) or nginx's worker
# connection budget fills faster than it drains. Defaults on Amazon Linux
# 2023 (somaxconn 4096, nginx worker_connections 1024, no upstream
# keep-alive) are too small for 1000+ concurrent clients hitting one box.
# ─────────────────────────────────────────────────────────────────────────────

files:
  "/etc/sysctl.d/99-eb-connection-tuning.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Accept-queue depth for listening sockets (nginx + the Go servers).
      net.core.somaxconn = 65535
      # Half-open (SYN) queue depth.
      net.ipv4.tcp_max_syn_backlog = 65535
      # NIC ingress backlog before the kernel starts dropping packets.
      net.core.netdev_max_backlog = 65535
      # Recycle TIME_WAIT sockets for new outbound connections
      # (nginx -> Go upstreams, Go gateway -> Go services).
      net.ipv4.tcp_tw_reuse = 1
      net.ipv4.tcp_fin_timeout = 15
      # Wider ephemeral range for all those upstream sockets.
      net.ipv4.ip_local_port_range = 1024 65535
      # Conntrack table — small default silently drops connections once full.
      net.netfilter.nf_conntrack_max = 262144

  "/etc/nginx/conf.d/99-eb-upstream-keepalive.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Reuse connections from nginx to the app instead of a fresh
      # handshake per request. Requires HTTP/1.1 + cleared Connection
      # header on the proxied request (set below).
      #
      # keepalive_timeout is NOT set here — nginx.conf's http{} block
      # already defines it (ships at 65s), and nginx rejects the same
      # directive twice in one context ("nginx: [emerg] ... directive
      # is duplicate", discovered 2026-09-02 once a deploy finally got
      # far enough to run `nginx -t`). The 02_raise_nginx_worker_limits
      # container command below patches that existing line to 120s
      # instead of duplicating it.
      upstream eb_app_keepalive_hint { server 127.0.0.1:80; keepalive 128; }
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      keepalive_requests 10000;

container_commands:
  01_apply_sysctl:
    command: "sysctl --system || true"
  02_raise_nginx_worker_limits:
    # worker_connections / worker_rlimit_nofile live in the main nginx.conf
    # (events{} + main context), which .platform/conf.d cannot reach, so
    # patch them in place idempotently.
    command: |
      set -e
      NGINX_CONF=/etc/nginx/nginx.conf
      grep -q 'worker_rlimit_nofile' $NGINX_CONF || sed -i '1i worker_rlimit_nofile 65535;' $NGINX_CONF
      sed -i 's/worker_processes.*/worker_processes auto;/' $NGINX_CONF
      sed -i 's/worker_connections[[:space:]]*[0-9]*;/worker_connections 16384;/' $NGINX_CONF
      sed -i 's/keepalive_timeout[[:space:]]*[0-9a-z]*;/keepalive_timeout 120s;/' $NGINX_CONF
      nginx -t
  03_reload_nginx:
    command: "systemctl reload nginx || service nginx reload || true"
