# ─────────────────────────────────────────────────────────────────────────────
# Load-test finding (2026-09-01):
#
#   VUs   failure rate     failure kind
#   300   0.00%            —
#   600   0.03%            TCP dial timeout (errno 10060), status=0, dur=0ms
#   1000  2–6%             TCP dial timeout (errno 10060), status=0, dur=0ms
#
# Every failure was a NEW CONNECTION that never got a SYN-ACK. Zero HTTP
# errors. /health (no DB, no proxy) failed at the SAME rate as the DB-backed
# endpoints, and p95 stayed at ~17 ms throughout — so the Go services, the
# DB pool and the indexes are NOT the bottleneck. The edge (ALB target +
# single EC2 instance accept queue) runs out of connection-acceptance
# capacity in bursts above ~600 concurrent clients.
#
# This file fixes that by giving the environment more than one instance and
# letting it scale on connection load instead of CPU.
# ─────────────────────────────────────────────────────────────────────────────
option_settings:
  aws:autoscaling:asg:
    MinSize: '2'
    MaxSize: '6'

  aws:autoscaling:launchconfiguration:
    # t3.small has a low network-connection ceiling; t3.medium roughly
    # doubles the burst allowance and the accept-queue headroom.
    InstanceType: t3.medium

  # Scale on requests-per-target, not CPU — the box was never CPU-bound
  # during the load test, it was connection-bound.
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    Port: '80'
    # Faster unhealthy-target eviction so a saturated instance is pulled
    # from rotation before it starts dropping SYNs for everyone.
    HealthCheckInterval: '10'
    HealthyThresholdCount: '2'
    UnhealthyThresholdCount: '3'

  aws:autoscaling:trigger:
    MeasureName: RequestCountPerTarget
    Statistic: Sum
    Unit: None
    Period: '1'
    BreachDuration: '1'
    UpperThreshold: '9000'
    LowerThreshold: '3000'
    UpperBreachScaleIncrement: '2'
    LowerBreachScaleIncrement: '-1'

  # Keep the ALB from closing upstream keep-alive connections too eagerly,
  # which forces fresh handshakes under load.
  aws:elbv2:loadbalancer:
    IdleTimeout: '120'
