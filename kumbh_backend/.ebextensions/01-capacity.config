# ─────────────────────────────────────────────────────────────────────────────
# Load-test finding (2026-09-01):
#
#   VUs   failure rate     failure kind
#   300   0.00%            —
#   600   0.03%            TCP dial timeout (errno 10060), status=0, dur=0ms
#   1000  2–6%             TCP dial timeout (errno 10060), status=0, dur=0ms
#
# Every failure was a NEW CONNECTION that never got a SYN-ACK. Zero HTTP
# errors. /health (no DB, no proxy) failed at the SAME rate as the DB-backed
# endpoints, and p95 stayed at ~17 ms throughout — so the Go services, the
# DB pool and the indexes are NOT the bottleneck. The edge (ALB target +
# single EC2 instance accept queue) runs out of connection-acceptance
# capacity in bursts above ~600 concurrent clients.
#
# This file fixes that by giving the environment more than one instance and
# letting it scale on connection load instead of CPU.
# ─────────────────────────────────────────────────────────────────────────────
# ─────────────────────────────────────────────────────────────────────────────
# 2026-09-02 revision: MinSize/MaxSize above never actually took effect in
# production — the live environment was found hard-capped at MinSize=
# MaxSize=4 (a manual console change had overridden this file, and nothing
# had re-deployed since to reassert it). A 10,000-VU load test against
# that fixed 4-instance ceiling failed 68.81% of requests.
#
# Kumbh Mela peak traffic is expected to genuinely reach that scale, so:
#   - MaxSize raised to 20 (at ~600-800 concurrent/instance from the
#     2026-09-01 finding below, ~20 instances covers a 10-16k VU peak).
#   - MinSize kept at 4 (today's running baseline — no disruptive
#     scale-down on redeploy).
#   - The old aws:autoscaling:trigger block used the aggregate RequestCount
#     metric as a workaround (that legacy namespace doesn't accept a
#     per-target metric). Replaced with a proper target-tracking policy on
#     ALBRequestCountPerTarget in Resources: below — this is the metric
#     that actually reflects load on EACH instance, so it scales evenly
#     instead of averaging load across however many instances happen to
#     be running.
# ─────────────────────────────────────────────────────────────────────────────
option_settings:
  aws:autoscaling:asg:
    MinSize: '4'
    MaxSize: '20'

  aws:autoscaling:launchconfiguration:
    # t3.small has a low network-connection ceiling; t3.medium roughly
    # doubles the burst allowance and the accept-queue headroom.
    InstanceType: t3.medium

  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
    Port: '80'
    # Faster unhealthy-target eviction so a saturated instance is pulled
    # from rotation before it starts dropping SYNs for everyone.
    HealthCheckInterval: '10'
    HealthyThresholdCount: '2'
    UnhealthyThresholdCount: '3'

  # Keep the ALB from closing upstream keep-alive connections too eagerly,
  # which forces fresh handshakes under load.
  aws:elbv2:loadbalancer:
    IdleTimeout: '120'

Resources:
  # Target-tracking scaling on requests-per-target — the box was never
  # CPU-bound during the load test, it was connection-bound, so CPU-based
  # scaling (EB's default) would not have reacted correctly. ~2000
  # requests/target is a starting point (well under the ~9000 aggregate
  # threshold the old trigger used across a 4-instance fleet, i.e.
  # roughly the same per-instance trip point) — tune after the next load
  # test.
  ConnectionLoadScalingPolicy:
    Type: AWS::AutoScaling::ScalingPolicy
    Properties:
      AutoScalingGroupName: {"Ref": "AWSEBAutoScalingGroup"}
      PolicyType: TargetTrackingScaling
      TargetTrackingConfiguration:
        PredefinedMetricSpecification:
          PredefinedMetricType: ALBRequestCountPerTarget
          ResourceLabel:
            Fn::Join:
              - "/"
              - - Fn::GetAtt: [AWSEBV2LoadBalancer, LoadBalancerFullName]
                - Fn::GetAtt: [AWSEBV2LoadBalancerTargetGroup, TargetGroupFullName]
        TargetValue: 2000
