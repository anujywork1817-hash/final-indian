# ============================================
# Kumbh Tent backend — local development env
# ============================================
# Copy to .env and fill in. Never commit a filled-in .env.
# For Elastic Beanstalk / production, see .env.aws.example.

# ── Database ────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/kumbh_tent?sslmode=disable

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=kumbh2027supersecretkey

# ── Service ports ───────────────────────────────────────
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
TENT_SERVICE_PORT=8082
BOOKING_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084

# ── Service discovery (used by the gateway) ─────────────
AUTH_SERVICE_URL=http://localhost:8081
TENT_SERVICE_URL=http://localhost:8082
BOOKING_SERVICE_URL=http://localhost:8083
PAYMENT_SERVICE_URL=http://localhost:8084

# ── Razorpay ────────────────────────────────────────────
# Needed by payment-service (to take money) AND by
# booking-service (to give it back on cancellation).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ── Firebase / FCM push notifications ───────────────────
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
# Alternatively inline the JSON (useful on EB where there is
# no convenient filesystem to mount a key into):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Booking confirmation email ──────────────────────────
# Sent by payment-service (online payment) and booking-service
# (cash-at-tent confirmation) once a booking moves to
# 'confirmed'. Leave unset to skip sending — it never blocks or
# fails the booking/payment flow either way.
# Any SMTP provider works; for Gmail use smtp.gmail.com:587 with
# an App Password (not your normal password) as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM_EMAIL=your-address@gmail.com
SMTP_FROM_NAME=Kumbh Tent Booking


# ============================================
# Refunds on cancellation
# ============================================

# Master switch. When false, cancelling still works but no
# refund is ever recorded or sent.
REFUND_ENABLED=true

# ── Approval gate ───────────────────────────────────────
#
# When true (the default), cancelling a booking records the
# refund as 'awaiting_approval' and sends NOTHING to Razorpay.
# Staff approve or reject it in the admin panel's Refunds tab:
#
#   POST /api/v1/admin/refunds/:ref/approve
#   POST /api/v1/admin/refunds/:ref/reject   (reason required)
#
# Only approval moves the refund to 'pending', where the normal
# execute/retry machinery picks it up. Nothing — not the retry
# worker, not the manual-settle endpoint — can bypass the gate.
#
# Set false to restore the old behaviour where a cancellation
# pays out immediately with no human in the loop.
REFUND_REQUIRE_APPROVAL=true

# How long the app tells customers to wait for the money.
# Appears verbatim in the app: "within <this> working days".
REFUND_SETTLEMENT_DAYS=3-4

# ── Cancellation policy ─────────────────────────────────
#
# REFUND_TIERS format:  <hours-of-notice>:<percent>, ...
#   "168:80,72:50,0:0"  →  >=168h before check-in  refund 80%
#                          >=72h                   refund 50%
#                          otherwise               refund 0%
#
# LEAVING THIS EMPTY MEANS 100% REFUND AT ANY NOTICE.
# That is the shipped default: it can never under-refund a
# customer, so an unconfigured deployment cannot quietly
# short-change anyone. Charging a cancellation fee is an
# explicit, opt-in decision.
REFUND_TIERS=

# ⚠️  IMPORTANT — POLICY MISMATCH TO RESOLVE BEFORE LAUNCH
#
# The app's own Terms & Conditions screen
# (kumbh_tent/lib/features/profile/screens/terms_screen.dart)
# publishes a DIFFERENT policy to users:
#
#     7+ days before check-in : 80% refund
#     3-6 days                : 50% refund
#     within 48 hours         : no refund
#
# The default above (100%) is more generous than those
# published terms, so it over-refunds relative to what
# customers were promised. To make behaviour match the
# published T&C exactly, uncomment this line instead:
#
# REFUND_TIERS=168:80,72:50,0:0
#
# Note the T&C itself has a gap: it defines 3-6 days and
# "within 48 hours" but says nothing about the 48-72h band.
# The line above treats 48-72h as 0% (no refund).

# Flat processing fee deducted from the refund, as a
# percentage. Applied AFTER the tier percentage.
# Default 0 — no fee is charged unless you set one.
REFUND_FEE_PERCENT=0

# ── Refund delivery mechanics ───────────────────────────

# Automatic gateway retries before a refund is parked for
# staff attention. Staff can always force more via
# POST /api/v1/admin/refunds/:ref/retry
REFUND_MAX_ATTEMPTS=6

# How often the background worker re-drives failed refunds.
REFUND_RETRY_INTERVAL_MINUTES=15

# Timeout for a single Razorpay refund API call.
REFUND_GATEWAY_TIMEOUT_SECONDS=20

# Razorpay refund speed: "normal" (free, 5-7 working days on
# Razorpay's side) or "optimum" (faster, Razorpay charges a
# fee). Note: if you promise 3-4 working days via
# REFUND_SETTLEMENT_DAYS, "normal" may not meet that promise —
# see the README.
RAZORPAY_REFUND_SPEED=normal
